<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.micronaut.platform</groupId><artifactId>micronaut-parent</artifactId><version>5.1.2</version>
  </parent>
  <groupId>com.example</groupId><artifactId>temporal-micronaut-showcase</artifactId><version>0.1.0</version><packaging>pom</packaging>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <kotlin.version>2.4.10</kotlin.version>
    <jackson.version>2.22.2</jackson.version>
    <temporal.version>1.38.0</temporal.version>
    <loki4j.version>2.1.0</loki4j.version>
  </properties>
  <modules>
    <module>shared/activity-contracts</module>
    <module>shared/activity-utils</module>
    <module>services/workflow-service</module>
    <module>services/validation-service</module>
    <module>services/customer-provisioning-service</module>
    <module>services/welcome-email-service</module>
    <module>services/payment-charging-service</module>
    <module>services/receipt-service</module>
    <module>services/client-update-service</module>
  </modules>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId><version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>io.micronaut.kotlin</groupId>
      <artifactId>micronaut-kotlin-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId><version>${kotlin.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-reflect</artifactId><version>${kotlin.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><groupId>io.micronaut.maven</groupId><artifactId>micronaut-maven-plugin</artifactId></plugin>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <configuration>
          <jvmTarget>${maven.compiler.release}</jvmTarget>
          <compilerPlugins><plugin>all-open</plugin></compilerPlugins>
          <pluginOptions>
            <option>all-open:annotation=io.micronaut.aop.Around</option>
            <option>all-open:annotation=io.micronaut.aop.Introduction</option>
            <option>all-open:annotation=jakarta.inject.Singleton</option>
            <option>all-open:annotation=io.micronaut.context.annotation.Context</option>
            <option>all-open:annotation=io.micronaut.http.annotation.Controller</option>
          </pluginOptions>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-maven-allopen</artifactId><version>${kotlin.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>kapt</id>
            <goals><goal>kapt</goal></goals>
            <configuration>
              <annotationProcessorPaths>
                <annotationProcessorPath>
                  <groupId>io.micronaut</groupId>
                  <artifactId>micronaut-inject-java</artifactId>
                </annotationProcessorPath>
              </annotationProcessorPaths>
            </configuration>
          </execution>
          <execution>
            <id>compile</id>
            <phase>compile</phase>
            <goals><goal>compile</goal></goals>
          </execution>
          <execution>
            <id>test-compile</id>
            <phase>test-compile</phase>
            <goals><goal>test-compile</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
